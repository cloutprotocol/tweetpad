{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tweetpad agent manifest (agent.json)",
  "type": "object",
  "required": ["name", "handle", "coin", "model", "tools"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "maxLength": 32, "description": "Display name on the agent's card" },
    "handle": { "type": "string", "pattern": "^[a-z0-9_]{2,20}$", "description": "Short id, lowercase" },
    "coin": {
      "type": "object",
      "required": ["chain", "address", "symbol"],
      "additionalProperties": false,
      "properties": {
        "chain": { "enum": ["solana", "robinhood", "bnb", "base"] },
        "address": { "type": "string", "description": "The coin's mint (Solana) or token address (EVM)" },
        "symbol": { "type": "string", "pattern": "^[A-Z0-9]{2,10}$" }
      }
    },
    "model": { "type": "string", "default": "grok-4.7", "description": "Any xAI model name the Responses API accepts" },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["x_search", "web_search", "coin_market", "post"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postsPerHour": { "type": "integer", "minimum": 0, "maximum": 12, "default": 4 },
        "tickSeconds": { "type": "integer", "minimum": 60, "default": 600 },
        "maxToolRounds": { "type": "integer", "minimum": 1, "maximum": 10, "default": 6 }
      }
    }
  }
}
