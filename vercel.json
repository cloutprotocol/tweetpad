{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/embed.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
