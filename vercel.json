{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/c/:mint",
      "destination": "/api/card?mint=:mint"
    },
    {
      "source": "/preview",
      "destination": "/preview.html"
    },
    {
      "source": "/winamp",
      "destination": "/winamp.html"
    },
    {
      "source": "/autoclaim",
      "destination": "/autoclaim.html"
    },
    {
      "source": "/custom",
      "destination": "/custom.html"
    },
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/games/pumpordump",
      "destination": "/games/pumpordump.html"
    },
    {
      "source": "/games/mines",
      "destination": "/games/mines.html"
    }
  ],
  "headers": [
    {
      "source": "/embed.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/winamp",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/winamp.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/autoclaim",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/autoclaim.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/custom",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/custom.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/games",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/games/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com"
        }
      ]
    },
    {
      "source": "/skills/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keeper",
      "schedule": "*/5 * * * *"
    }
  ]
}
